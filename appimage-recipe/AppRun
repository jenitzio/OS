#!/bin/sh
HERE="$(dirname "$(readlink -f "${0}")")"

if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "Error: QEMU is required to run this OS sandbox."
    echo "Please install it via: sudo apt install qemu-system-x86"
    exit 1
fi

exec qemu-system-x86_64 \
    -cdrom "$HERE/usr/share/myos/core.iso" \
    -m 1024M \
    -vga std \
    -display sdl,gl=on \
    -boot d
