#!/bin/sh
set -eu

HERE="$(dirname "$(readlink -f "${0}")")"
DATA_HOME="${XDG_DATA_HOME:-"$HOME/.local/share"}/myportableos"
BASE_IMAGE="$HERE/usr/share/myos/persistence-base.qcow2"
PERSISTENCE_IMAGE="$DATA_HOME/persistence.qcow2"

if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "Error: QEMU is required to run this OS sandbox."
    echo "Please install it via: sudo apt install qemu-system-x86"
    exit 1
fi

if ! command -v qemu-img >/dev/null 2>&1; then
    echo "Error: qemu-img is required to create the persistent virtual disk."
    echo "Please install it via: sudo apt install qemu-utils"
    exit 1
fi

if [ ! -f "$BASE_IMAGE" ]; then
    echo "Error: the bundled persistence base image is missing: $BASE_IMAGE" >&2
    exit 1
fi

mkdir -p "$DATA_HOME"
if [ ! -f "$DATA_HOME/persistence-base.qcow2" ]; then
    cp "$BASE_IMAGE" "$DATA_HOME/persistence-base.qcow2"
fi
if [ ! -f "$PERSISTENCE_IMAGE" ]; then
    qemu-img create -f qcow2 -F qcow2 \
        -b "$DATA_HOME/persistence-base.qcow2" "$PERSISTENCE_IMAGE"
fi

exec qemu-system-x86_64 \
    -cdrom "$HERE/usr/share/myos/core.iso" \
    -m 4096M \
    -smp 2 \
    -vga std \
    -display sdl,gl=on \
    -nic user,model=e1000 \
    -drive "file=$PERSISTENCE_IMAGE,format=qcow2,if=virtio" \
    -boot d
